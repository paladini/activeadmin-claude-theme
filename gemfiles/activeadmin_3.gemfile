source "https://rubygems.org"

gemspec path: ".."

gem "rails", "~> 7.2.0"
gem "sprockets-rails"
gem "sassc-rails"
gem "devise"
gem "activeadmin", "~> 3.5.0"
gem "sqlite3", "~> 2.1"
gem "puma"
gem "capybara"
gem "rack-test"
gem "minitest", "~> 5.25"
gem "tzinfo-data", platforms: %i[windows jruby]

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
end
